# Шаблон: приложение НЕ загружает .env автоматически.
# PowerShell: $env:AEGML_LLM_MODE = 'mock'
# mock — публичная заглушка; local/api пока завершаются явной ошибкой.
AEGML_LLM_MODE=mock

# Конкретная модель и адрес будут выбраны после правил организаторов.
AEGML_MODEL_NAME=
AEGML_MODEL_ENDPOINT=

# Реальные секреты не нужны для DEMO. Для будущих интеграций храните их
# только в переменных окружения; не добавляйте ключи в этот файл или Git.
