# docker compose up --build; default external port is 8080.
APP_PORT=8080
POSTGRES_PASSWORD=replace-with-local-random-password
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Set true only for a project with billing disabled and eligible free quota.
GEMINI_FREE_TIER_CONFIRMED=false
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional explicit :free backup; empty disables it. Account limits are never bypassed.
OPENROUTER_BACKUP_MODEL=
OPENROUTER_API_KEY=
MAX_LLM_CALLS_PER_DAY=40
MAX_LLM_CALLS_PER_RUN=2
PROVIDER_TIMEOUT=25
MAX_MESSAGE_CHARS=8000
LITEAPI_MODE=sandbox
LITEAPI_API_KEY=
DUFFEL_ACCESS_TOKEN=
SERPAPI_API_KEY=
SERPAPI_FREE_TIER_CONFIRMED=false
HOTELBEDS_API_KEY=
HOTELBEDS_API_SECRET=
HOTELBEDS_TEST_CONFIRMED=false
RATEHAWK_KEY_ID=
RATEHAWK_API_KEY=
RATEHAWK_TEST_CONFIRMED=false
TRAVELPAYOUTS_API_TOKEN=
# Actual frontend origins; session bearer token is required by session endpoints.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:8081
