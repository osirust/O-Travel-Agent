# docker compose up --build; default external port is 8080.
APP_PORT=8080
POSTGRES_PASSWORD=replace-with-local-random-password
LLM_PROVIDER=openrouter
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Set true only for a project with billing disabled and eligible free quota.
GEMINI_FREE_TIER_CONFIRMED=false
# Optional Groq comparison. Hidden entry: py scripts/configure_keys.py
# Owner obtains the key at https://console.groq.com/keys; do not paste it in chat.
# Keep the current LLM_PROVIDER until the comparison is complete.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
# Set true only after confirming a Groq Free account without billing/paid plan.
GROQ_FREE_TIER_CONFIRMED=false
# Stored for future comparison only; these entries do not select a provider.
ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash
ZAI_FREE_TIER_CONFIRMED=false
COHERE_API_KEY=
COHERE_EVALUATION_CONFIRMED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_FREE_TIER_CONFIRMED=false
NVIDIA_API_KEY=
NVIDIA_PROTOTYPING_CONFIRMED=false
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
# Optional explicit :free backup; empty disables it. Account limits are never bypassed.
OPENROUTER_BACKUP_MODEL=
OPENROUTER_API_KEY=
MAX_LLM_CALLS_PER_DAY=40
# Separate application guard; increase only for an explicit Free evaluation.
# This does not increase the provider's allowance or enable billing.
MAX_CLOUDFLARE_LLM_CALLS_PER_DAY=40
MAX_LLM_CALLS_PER_RUN=2
PROVIDER_TIMEOUT=25
LLM_REQUEST_TIMEOUT=45
LLM_REASONING_ENABLED=false
LLM_MAX_OUTPUT_TOKENS=4096
MAX_MESSAGE_CHARS=8000
LITEAPI_MODE=sandbox
# HYBRID uses configured provider APIs for new trips; explicit DEMO remains available.
DEFAULT_SEARCH_MODE=DEMO
DEFAULT_HOTEL_PROVIDER=liteapi
DEFAULT_FLIGHT_PROVIDER=serpapi
LITEAPI_API_KEY=
DUFFEL_ACCESS_TOKEN=
SERPAPI_API_KEY=
SERPAPI_FREE_TIER_CONFIRMED=false
HOTELBEDS_API_KEY=
HOTELBEDS_API_SECRET=
HOTELBEDS_TEST_CONFIRMED=false
RATEHAWK_KEY_ID=
RATEHAWK_API_KEY=
RATEHAWK_TEST_CONFIRMED=false
TRAVELPAYOUTS_API_TOKEN=
# Actual frontend origins; session bearer token is required by session endpoints.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:8081
