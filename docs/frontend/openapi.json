  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "pause",
              "resume",
              "undo",
              "cancel"
            ],
            "title": "Action"
          },
          "client_message_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Message Id"
          },
          "expected_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action"
        ],
        "title": "Action"
      },
      "Budget": {
        "properties": {
          "amount_minor": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Amount Minor"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "default": "RUB"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": "whole_trip"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount_minor"
        ],
        "title": "Budget"
      },
      "Commands": {
        "properties": {
          "client_message_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Client Message Id"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "operations": {
            "items": {
              "$ref": "#/components/schemas/Operation"
            },
